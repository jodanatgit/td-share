rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with a confirmed @totaldigital.se address (email-link sign-in verifies the address)
    function isTD() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@totaldigital[.]se$');
    }

    // The signer's user name: firstname, or firstname.lastname for people in FULL_NAME_USERS (src/auth.ts)
    function isMe(name) {
      return name in [
        request.auth.token.email.lower().split('@')[0],
        request.auth.token.email.lower().split('@')[0].split('[.]')[0]
      ];
    }

    function event(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function isRunning(eventId) {
      return request.time < event(eventId).endsAt;
    }

    function isPlaceText(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.info is string && d.info.size() <= 2000;
    }

    function isPosition(d) {
      return d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.accuracy is number && d.accuracy >= 0;
    }

    // My opt-in: which running event I share my position in (one at a time). The OwnTracks endpoint
    // (functions/index.js) only stores positions while this exists. Its lastPoint field is server-owned.
    match /sharing/{userName} {
      allow read, delete: if isTD() && isMe(userName);
      allow create, update: if isTD()
        && isMe(userName)
        && request.resource.data.keys().hasOnly(['eventId', 'since'])
        && request.resource.data.eventId is string
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && isRunning(request.resource.data.eventId)
        && request.resource.data.since == request.time;
    }

    // OwnTracks passwords (hashed) live in owntracks_tokens/{userName}: server only, no rule = no access.

    // An event (workshop, conference...) people can share their position in. Runs from creation to endsAt,
    // at most three days. The creator can rename it or end it early, never extend it.
    match /events/{eventId} {
      allow read: if isTD();
      allow create: if isTD()
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt', 'endsAt', 'expireAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && isMe(request.resource.data.createdBy)
        && request.resource.data.createdAt == request.time
        && request.resource.data.endsAt is timestamp
        && request.resource.data.endsAt > request.time
        && request.resource.data.endsAt <= request.time + duration.value(169, 'h')
        && request.resource.data.expireAt == request.resource.data.endsAt;
      allow update: if isTD()
        && isMe(resource.data.createdBy)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'endsAt', 'expireAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.endsAt is timestamp
        && request.resource.data.endsAt <= resource.data.endsAt
        && request.resource.data.expireAt == request.resource.data.endsAt;
      allow delete: if isTD() && isMe(resource.data.createdBy);

      // Each sharer's latest position, document id = user name. Readable only while the event runs.
      match /members/{userName} {
        allow read: if isTD() && isRunning(eventId);
        allow create, update: if isTD()
          && isMe(userName)
          && isRunning(eventId)
          && request.resource.data.keys().hasOnly(['userName', 'lat', 'lng', 'accuracy', 'updatedAt', 'expireAt'])
          && request.resource.data.userName == userName
          && isPosition(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.expireAt == event(eventId).endsAt;
        allow delete: if isTD() && (isMe(userName) || isMe(event(eventId).createdBy));
      }

      // Everyone's track during the event. Never changed; readable only while the event runs.
      match /points/{pointId} {
        allow read: if isTD() && isRunning(eventId);
        allow create: if isTD()
          && isRunning(eventId)
          && request.resource.data.keys().hasOnly(['userName', 'lat', 'lng', 'accuracy', 'at', 'expireAt'])
          && isMe(request.resource.data.userName)
          && isPosition(request.resource.data)
          && request.resource.data.at == request.time
          && request.resource.data.expireAt == event(eventId).endsAt;
        allow update: if false;
        allow delete: if isTD() && (isMe(resource.data.userName) || isMe(event(eventId).createdBy));
      }

      // Places marked on the map with a title and info. Anyone can add one while the event runs; the person who
      // added it and the event creator can edit, move and delete it.
      match /places/{placeId} {
        allow read: if isTD() && isRunning(eventId);
        allow create: if isTD()
          && isRunning(eventId)
          && request.resource.data.keys().hasOnly(['title', 'info', 'lat', 'lng', 'createdBy', 'createdAt', 'expireAt'])
          && isPlaceText(request.resource.data)
          && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
          && isMe(request.resource.data.createdBy)
          && request.resource.data.createdAt == request.time
          && request.resource.data.expireAt == event(eventId).endsAt;
        allow update: if isTD()
          && isRunning(eventId)
          && (isMe(resource.data.createdBy) || isMe(event(eventId).createdBy))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'info', 'lat', 'lng'])
          && isPlaceText(request.resource.data)
          && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;
        allow delete: if isTD() && (isMe(resource.data.createdBy) || isMe(event(eventId).createdBy));
      }

      // "X kom fram till Y": written by the server when someone reaches a place or route (functions/arrivals.js).
      // What each person is at right now (presence/{userName}) is server only.
      match /arrivals/{arrivalId} {
        allow read: if isTD() && isRunning(eventId);
        allow delete: if isTD() && isMe(event(eventId).createdBy);
      }

      // Uploaded GPX routes and routes drawn on the map (GPX parsed in the browser, src/gpx.ts). Deleted by uploader or event creator.
      match /routes/{routeId} {
        allow read: if isTD() && isRunning(eventId);
        allow create: if isTD()
          && isRunning(eventId)
          && request.resource.data.keys().hasOnly(['name', 'color', 'coords', 'breaks', 'waypoints', 'createdBy', 'createdAt', 'expireAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.color is string
          && request.resource.data.color.matches('#[0-9a-fA-F]{6}')
          && request.resource.data.coords is list
          && request.resource.data.coords.size() <= 16004
          && request.resource.data.breaks is list
          && request.resource.data.breaks.size() <= 1000
          && request.resource.data.waypoints is list
          && request.resource.data.waypoints.size() <= 200
          && isMe(request.resource.data.createdBy)
          && request.resource.data.createdAt == request.time
          && request.resource.data.expireAt == event(eventId).endsAt;
        // The uploader can reshape and rename their own route (the app offers it for drawn routes)
        allow update: if isTD()
          && isRunning(eventId)
          && isMe(resource.data.createdBy)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'coords', 'breaks'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.coords is list
          && request.resource.data.coords.size() >= 4
          && request.resource.data.coords.size() <= 16004
          && request.resource.data.breaks is list
          && request.resource.data.breaks.size() <= 1000;
        allow delete: if isTD() && (isMe(resource.data.createdBy) || isMe(event(eventId).createdBy));
      }
    }
  }
}
